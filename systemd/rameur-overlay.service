# Service systemd pour le serveur compagnon.
# Installer :
#   sudo cp systemd/rameur-overlay.service /etc/systemd/system/
#   sudo systemctl edit --full rameur-overlay  # adapter User= et WorkingDirectory=
#   sudo systemctl enable --now rameur-overlay
[Unit]
Description=Rameur overlay (serveur compagnon vidéo/QR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# À ADAPTER : remplace « pi » par ton utilisateur et le chemin par l'emplacement réel.
User=pi
WorkingDirectory=/home/pi/rameur-overlay
ExecStart=/usr/bin/node server/server.js
Environment=PORT=8443
# Environment=NODE_ENV=production
# Décommente et adapte si ORM n'est pas sur ws://localhost/websocket :
# Environment=ORM_WS_URL=ws://localhost:80/websocket
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
